OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_FALLBACK_MODELS=

GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
OPENALEX_API_KEY=

# Auth
# Required in production: a randomly generated value of at least 32 characters.
JWT_SECRET=
# Public HTTPS frontend origin in production (used for CORS and OAuth return validation).
CLIENT_URL=http://127.0.0.1:5173
# Optional additional exact origins, separated by commas. Production requires HTTPS.
AUTH_ALLOWED_ORIGINS=
# Optional persistent storage directory (mount a durable volume for container deployments).
NEZBIG_DATA_DIR=

# Google OAuth (optional — create at https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://127.0.0.1:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback
