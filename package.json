{
  "name": "nezbig",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --configLoader runner",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:server && tsc --noEmit && vite build --configLoader runner",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --experimental-specifier-resolution=node .vercel-server/server/index.js",
    "test": "vitest run --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/unit/**/*.{ts,tsx}\"",
    "calibrate": "tsx scripts/calibrate.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dompurify": "^3.4.12",
    "duck-duck-scrape": "^2.2.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "franc-min": "^6.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postcss": "^8.5.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.2",
    "simple-icons": "^16.27.0",
    "tailwindcss": "^3.4.19",
    "vite-plugin-commonjs": "^0.10.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.15"
  }
}
